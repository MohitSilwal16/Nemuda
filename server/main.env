# MySQL Configuration for Authentication & Fetching Previous Messages

# MySQL Database Name
sqlDBName="Nemuda"

# MySQL User
sqlDBUser="root"

# MySQL Password
sqlDBPass="kali"

# MySQL Port (default is 3306)
sqlDBPort="3306"

# MongoDB Configuration to Store Blogs

# MongoDB Database Name
mongoDBName="Nemuda"

# MongoDB Collection Name
mongoCollectionName="Blogs"